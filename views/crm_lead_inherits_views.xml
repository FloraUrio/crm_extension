<odoo>
    <record id="view_crm_lead_inherit_form" model="ir.ui.view">

        <field name="name">crm.lead.inherit.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>

        <field name="arch" type="xml">
           <!--<xpath expr="//form/sheet//div/field[@name='email_from']/.." position="before">-->
           <!--<xpath expr="//form/sheet//label[@for='email_from']" position="before">-->
           <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="after">
               <field name="contact_type"/>
            </xpath>
        

        <xpath expr = "//field[@name = 'expected_revenue']" position = "after">
             <field name = "deal_size"/>
        </xpath>

        <xpath expr = "//field[@name = 'date_deadline']" position = "after">
             <field name = "date_open"/>
        </xpath>

        <xpath expr = "//field[@name = 'tag_ids']" position = "after">
             <field name = "day_open"/>
        </xpath>
    
    </field>

 </record>

</odoo>